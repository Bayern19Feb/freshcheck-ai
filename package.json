{
  "name": "freshcheck-ai",
  "version": "0.3.0",
  "private": true,
  "description": "FreshCheck AI - a school science exhibition app that uses a browser-based image classifier to estimate visible fruit freshness.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs public 8080",
    "vendor": "node tools/vendor.mjs",
    "make:icons": "node tools/make-icons.mjs",
    "make:test-model": "node tools/make-test-model.mjs",
    "dataset": ".venv/Scripts/python tools/dataset/fetch_datasets.py",
    "train": "node tools/train/train.mjs && node tools/train/report.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "check": "node tools/check.mjs && npm test && npm run test:e2e"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@teachablemachine/image": "0.8.5",
    "@tensorflow/tfjs": "1.3.1",
    "puppeteer-core": "23.11.1"
  }
}
